const $ = id => document.getElementById(id);

function formatMoney(value) {
  if (isNaN(value) || !isFinite(value)) return '0 €';
  const rounded = Math.round(value);
  return rounded.toLocaleString('fr-FR') + ' €';
}

function formatPercent(value) {
  if (isNaN(value) || !isFinite(value)) return '0 %';
  return Math.round(value) + ' %';
}

// ══════════════════════════════════════════════════════════════════
// CALCUL D'UN SCÉNARIO
// ══════════════════════════════════════════════════════════════════
function computeScenario(baseRevenue, totalCharges, baseOccupancy, adjustment) {
  const factor = 1 + (adjustment / 100);
  const adjustedRevenue = baseRevenue * factor;
  const adjustedOccupancy = baseOccupancy * factor;
  const profit = adjustedRevenue - totalCharges;
  const yearly = profit * 12;
  return {
    occupancy: Math.max(0, Math.min(100, adjustedOccupancy)),
    revenue: adjustedRevenue,
    charges: totalCharges,
    profit: profit,
    yearly: yearly
  };
}

